        <mxCell id="note27" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Chat_Conversation: UNIQUE (Member_ID, Coach_ID)" vertex="1">
          <mxGeometry x="60" y="2470" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note28" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Subject_Room_Type: PK (Subject_ID, Room_Type); FK Subject_ID -&gt; Subject (ON DELETE CASCADE). Room.Room_Type &amp; Subject_Room_Type.Room_Type gồm 12 loại phòng." vertex="1">
          <mxGeometry y="2560" width="1360" height="80" x="60" as="geometry" />
        </mxCell>
        <mxCell id="note29" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Member_Notification: UNIQUE (Member_ID, Source_Key); Type IN (PACKAGE_EXPIRING, TRAINING_PLAN_ASSIGNED); Reference_Type IN (MEMBERSHIP, TRAINING_PLAN)." vertex="1">
          <mxGeometry y="2650" width="1360" height="80" x="60" as="geometry" />
        </mxCell>
        <mxCell id="note30" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Membership_Package.Freeze_Months &gt;= 0 (chỉ &gt; 0 khi Duration &gt;= 180). Member_Subscription.Status IN (Pending, Active, Frozen, Expired, Cancelled) kèm cặp Freeze_Started_At / Freeze_Ends_At." vertex="1">
          <mxGeometry y="2740" width="1360" height="80" x="60" as="geometry" />
        </mxCell>
        <mxCell id="note31" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="User: Email_Verified, Auth_Provider IN (LOCAL, GOOGLE, UNKNOWN), Session_Version dùng thu hồi JWT &amp; WebSocket." vertex="1">
          <mxGeometry y="2830" width="1360" height="80" x="60" as="geometry" />
        </mxCell>
        <mxCell id="note32" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Class.Has_PT (chỉ bật cho môn Gym/Fitness) và Refund_Request.Refund_Policy (ví dụ CLASS_CANCEL_50)." vertex="1">
          <mxGeometry y="2920" width="1360" height="80" x="60" as="geometry" />
        </mxCell>
      </root>

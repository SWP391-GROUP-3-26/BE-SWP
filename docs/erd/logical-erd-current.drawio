  <diagram id="notes" name="07 - Ghi chu va rang buoc">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="3050">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="note0" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;" value="Ghi chú đối chiếu và ràng buộc" vertex="1">
          <mxGeometry x="60" y="40" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Nguồn: swp391_db.sql; toàn bộ migrations đến 10/11/2026; đối chiếu @Table/@Column/@JoinColumn trong entity và VoucherPaymentLinkRepository." vertex="1">
          <mxGeometry x="60" y="130" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note2" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Giữ kiểu bảng hai cột của file gốc; tăng chiều rộng để đọc đủ tên cột. Trang tổng là một schema; bảng lặp ở tab chi tiết chỉ là các góc nhìn của cùng bảng." vertex="1">
          <mxGeometry x="60" y="220" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note3" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Ký hiệu: PK = khóa chính; FK = khóa ngoại; PK,FK = cùng là hai loại khóa. Đầu || = đúng 1; o| = 0 hoặc 1; o&lt; = 0 đến nhiều. Quan hệ thể hiện ràng buộc schema, không suy ra số bản ghi tối thiểu từ nghiệp vụ." vertex="1">
          <mxGeometry x="60" y="310" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note4" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Schedule còn trong DDL nhưng chưa có entity/service sử dụng (bảng legacy). Voucher đã có luồng áp dụng vào Payment.Voucher_ID (VoucherApplicationService), hiện chưa có UI/API CRUD Voucher." vertex="1">
          <mxGeometry x="60" y="400" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note5" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Membership_Package.Included_Classes đã bị xóa (20261108_drop_membership_session_quota.sql) do chuyển sang Unlimited Membership. Class.Time và các cột legacy trong Training_Exercise vẫn tồn tại; nguồn buổi học chính là Class_Session." vertex="1">
          <mxGeometry x="60" y="490" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note6" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Email_Otp_Challenge.User_ID, Membership_Sport_Selection.Choice_Group_ID và Refund_Session.Session_ID không có FK cứng trong DDL. Không nối quan hệ chỉ vì tên cột có hậu tố _ID." vertex="1">
          <mxGeometry x="60" y="580" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note7" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Payment: Subscription_ID và Booking_ID loại trừ nhau theo Payment_Type. Renewal_Subscription_ID là liên kết riêng tới membership cũ. Các FK nullable được vẽ đầu cha o|." vertex="1">
          <mxGeometry x="60" y="670" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note8" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Training_Plan.Class_ID: SQL cho phép NULL cho dữ liệu cũ dù entity khai báo nullable=false. ERD dùng nullability của DDL. Plan CLASS yêu cầu Class_ID có giá trị và Member_ID NULL; INDIVIDUAL yêu cầu Member_ID có giá trị." vertex="1">
          <mxGeometry x="60" y="760" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note9" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Chỉ số duy nhất có điều kiện: User.Phone khi khác NULL; Class_Booking(Registration_Code,Session_ID) khi Registration_Code khác NULL; Payment.Sepay_Transaction_ID khi khác NULL; Refund_Request.Pickup_Code khi khác NULL; Training_Plan(Class_ID,Member_ID) khi Status=ASSIGNED." vertex="1">
          <mxGeometry x="60" y="850" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note10" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Role: UNIQUE (Role_Name)" vertex="1">
          <mxGeometry x="60" y="940" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note11" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="User: UNIQUE (Username)" vertex="1">
          <mxGeometry x="60" y="1030" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note12" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="User: UNIQUE (Email)" vertex="1">
          <mxGeometry x="60" y="1120" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note13" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Membership_Package: UNIQUE (Name)" vertex="1">
          <mxGeometry x="60" y="1210" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note14" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Subject: UNIQUE (Name)" vertex="1">
          <mxGeometry x="60" y="1300" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note15" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Room: UNIQUE (Name)" vertex="1">
          <mxGeometry x="60" y="1390" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note16" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Class_Session: UNIQUE (Class_ID, Date, Start_Time)" vertex="1">
          <mxGeometry x="60" y="1480" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note17" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Voucher: UNIQUE (Code)" vertex="1">
          <mxGeometry x="60" y="1570" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note18" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Training_Plan_Recipient: UNIQUE (Plan_ID, Member_ID)" vertex="1">
          <mxGeometry x="60" y="1660" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note19" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Training_Exercise_Result: UNIQUE (Recipient_ID, Exercise_ID)" vertex="1">
          <mxGeometry x="60" y="1750" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note20" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Attendance: UNIQUE (Session_ID, User_ID)" vertex="1">
          <mxGeometry x="60" y="1840" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note21" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Training_Result: UNIQUE (Session_ID, User_ID)" vertex="1">
          <mxGeometry x="60" y="1930" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note22" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Refund_Request: UNIQUE (Payment_ID)" vertex="1">
          <mxGeometry x="60" y="2020" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note23" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Package_Included_Sport: UNIQUE (Package_ID, Subject_ID)" vertex="1">
          <mxGeometry x="60" y="2110" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note24" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Package_Choice_Group_Sport: UNIQUE (Choice_Group_ID, Subject_ID)" vertex="1">
          <mxGeometry x="60" y="2200" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note25" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Membership_Sport_Selection: UNIQUE (Subscription_ID, Choice_Group_ID, Subject_ID)" vertex="1">
          <mxGeometry x="60" y="2290" width="1360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note26" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;" value="Membership_Included_Sport: UNIQUE (Subscription_ID, Subject_ID)" vertex="1">
          <mxGeometry x="60" y="2380" width="1360" height="80" as="geometry" />

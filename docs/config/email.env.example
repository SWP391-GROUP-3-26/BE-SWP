# Copy these settings into the ignored BE-SWP/.env and fill using your SMTP provider.
# Do not commit the real credentials. MAIL_FROM must be permitted by the provider.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=unisport@example.com
MAIL_PASSWORD=replace-with-smtp-credential
MAIL_FROM=unisport@example.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
